# ==========================================
# PORTFOLIO BACKEND ENVIRONMENT CONFIGURATION
# ==========================================

# Server Port
PORT=1268

# Node Environment ('development' or 'production')
NODE_ENV=development

# Allowed Frontend URL for CORS (no trailing slash)
# Can be comma-separated for multiple: https://myportfolio.vercel.app,https://raishivam8.github.io
FRONTEND_URL=https://myportfolio-rust-three-36.vercel.app

# MongoDB Atlas Connection String (Optional)
# If provided, submitted messages will also be saved to MongoDB
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/portfolio?retryWrites=true&w=majority

# ==========================================
# EMAIL — OPTION 1: RESEND API (RECOMMENDED FOR RENDER)
# ==========================================
# Render Free tier BLOCKS outbound SMTP ports (465 & 587).
# Use Resend instead — it sends via HTTPS (port 443, never blocked).
# Free tier: 3,000 emails/month | Sign up at https://resend.com
#
# IMPORTANT: Add RESEND_API_KEY in Render Dashboard → Environment tab
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Optional: customize the "from" address (must be a verified domain in Resend)
RESEND_FROM=Portfolio Contact <onboarding@resend.dev>

# ==========================================
# EMAIL — OPTION 2: GMAIL SMTP (LOCAL DEV ONLY)
# ==========================================
# Works locally but NOT on Render Free tier (SMTP ports are blocked).
# Use an App Password from: Google Account → Security → 2-Step → App Passwords
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_SECURE=true
MAIL_USER=raishivamrai837@gmail.com
MAIL_PASS=your-16-character-gmail-app-password
MAIL_TO=raishivamrai837@gmail.com

